.git/
.gitignore

# Tests (not needed in prod image)
test/
integration_test/

# Docker files
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Docs
README.md
docs/

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log