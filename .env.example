# Build-time API endpoint — baked into the JavaScript bundle.
#
# This URL is used by the USER'S BROWSER, not by the container.
# It must be reachable from wherever the browser runs.
#
# Dev:        http://localhost:8000/api/v1
# Staging:    https://api.staging.example.com/api/v1
# Production: https://api.example.com/api/v1
API_BASE_URL=http://localhost:8000/api/v1